# Faceless Memebot — copy to .env and adjust

# Output directory for generated memes (default: output)
OUTPUT_DIR=output

# Approved memes directory (default: output/approved)
APPROVED_DIR=output/approved

# Content niche / subreddit for trend sourcing (default: memes)
NICHE=memes
REDDIT_SUBREDDITS=memes,dankmemes,technology,worldnews

# How many memes per batch when using scheduler (default: 5)
BATCH_SIZE=5

# --- Reddit OAuth (optional; more reliable than public JSON API) ---
# Create app at https://www.reddit.com/prefs/apps (script type)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=FacelessMemebot/1.0 by your_reddit_username

# --- LLM captions (optional) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=auto
# Use --llm flag to force LLM when a key is present

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Scheduler timezone (default: UTC)
SCHEDULER_TIMEZONE=UTC

# --- Video export defaults ---
VIDEO_DURATION=5.0
VIDEO_FPS=30

# --- X (Twitter) posting ---
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# --- Instagram Graph API ---
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=

# --- TikTok Content Posting API ---
# TIKTOK_ACCESS_TOKEN=

# --- YouTube Data API (OAuth bearer token for uploads) ---
# YOUTUBE_API_KEY=
# YOUTUBE_OAUTH_TOKEN=
