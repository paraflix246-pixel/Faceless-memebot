# Faceless Memebot + Shorts Factory Bot — copy to .env and adjust

# =============================================================================
# Shorts Factory Bot (python generate.py)
# =============================================================================

# DeepSeek API (OpenAI-compatible) — script generation
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Gemini fallback for scripts
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-lite

# Character image search (free, no key — tried first for topic-accurate visuals)
# DDG_IMAGE_SEARCH_ENABLED=true
# DDG_SEARCH_TIMEOUT=30
# DDG_MAX_RESULTS=8

# Image generation (optional — DDG search / Pollinations / Pillow used if unset)
# REPLICATE_API_KEY=
# REPLICATE_MODEL=stability-ai/sdxl:39ed52f2a78e934b3ba6e2a89fbf45f8563961995bd1e021954279dd967832d
# OPENAI_API_KEY=sk-...          # for DALL-E 3 (set DALLE_ENABLED=true)
# DALLE_ENABLED=false
# SD_LOCAL_ENABLED=false
# SD_LOCAL_URL=http://127.0.0.1:7860
# POLLINATIONS_ENABLED=true        # free AI images, no key (default: true)
# POLLINATIONS_TIMEOUT=90

# Edge TTS — English voice and rate
# EDGE_TTS_VOICE=en-US-AriaNeural
# EDGE_TTS_RATE=+0%

# =============================================================================
# Faceless Memebot (python -m memebot)
# =============================================================================

# Output directory for generated memes (default: output)
OUTPUT_DIR=output

# Approved memes directory (default: output/approved)
APPROVED_DIR=output/approved

# Content niche / subreddit for trend sourcing (default: memes)
NICHE=memes
REDDIT_SUBREDDITS=memes,dankmemes,technology,worldnews

# How many memes per batch when using scheduler (default: 5)
BATCH_SIZE=5

# --- Reddit OAuth (optional; more reliable than public JSON API) ---
# Create app at https://www.reddit.com/prefs/apps (script type)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=FacelessMemebot/1.0 by your_reddit_username

# --- LLM captions (optional) ---
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=auto
# Use --llm flag to force LLM when a key is present

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Scheduler timezone (default: UTC)
SCHEDULER_TIMEZONE=UTC

# --- Video export defaults ---
VIDEO_DURATION=5.0
VIDEO_FPS=30

# --- X (Twitter) posting ---
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# --- Instagram Graph API ---
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=

# --- TikTok Content Posting API ---
# TIKTOK_ACCESS_TOKEN=

# --- YouTube Data API (OAuth bearer token for uploads) ---
# YOUTUBE_API_KEY=
# YOUTUBE_OAUTH_TOKEN=
